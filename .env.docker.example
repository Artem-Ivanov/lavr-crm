# Run scripts/start.sh to generate .env.docker with unique passwords.
# This example is documentation: empty secrets cannot start the stack.
APP_MODE=api
APP_BIND=127.0.0.1
APP_PORT=8080
POSTGRES_DB=lavr
POSTGRES_USER=lavr
POSTGRES_PASSWORD=
# Set an explicitly trusted admin email before the first bootstrap.
ADMIN_LOGIN=
ADMIN_PASSWORD=
SESSION_SECRET=
# Generated by scripts/start.sh for a fresh installation. Keep backups of keys
# separately from PostgreSQL backups; missing keys cannot decrypt existing data.
PII_ENCRYPTION_KEYS=
PII_ACTIVE_KEY_ID=v1
PII_INDEX_KEY=
CHALLENGE_SECRET=
# Existing installations: stop writers/back up first; set true only for migration.
PII_MIGRATION_MAINTENANCE=false
# Enable only after a real SMTP delivery test and starting verification-emails.
CUSTOMER_REGISTRATION_ENABLED=false
SMTP_HOST=
SMTP_PORT=465
SMTP_TLS_MODE=tls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
# false is for local HTTP. Use true behind HTTPS in production.
COOKIE_SECURE=false
# true seeds an example catalog in a new database; production: false.
SEED_DEMO_CATALOG=true
# Telegram notifications are optional; feedback is accepted while these are empty.
# Keep false for connection checks and a single explicit test; true sends the backlog.
TELEGRAM_NOTIFICATIONS_ENABLED=false
# Keep direct for the current installation until the explicit relay cutover.
NOTIFICATION_TRANSPORT=direct
NOTIFICATION_RELAY_TARGET=
NOTIFICATION_RELAY_TOKEN=
NOTIFICATION_RELAY_CA_FILE=
NOTIFICATION_DESTINATION_ALIAS=mirzap67.staff
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Reachable origin for the manager's browser; use HTTPS for server deployment.
# May stay empty for a single technical test without a CRM button.
PUBLIC_SITE_URL=
# Only the internal frontend proxy may supply the client IP to the backend.
TRUSTED_PROXY_HOSTS=172.16.0.0/12
